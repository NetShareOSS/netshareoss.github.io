{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Netshare Site (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve:5500"
    },
    {
      "name": "Netshare Site (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5500",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "serve:5500"
    },
    {
      "name": "Open index.html (no server)",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    }
  ]
}
